    "generate_confirmation": {
      "spec": {
        "kind": "prompt",
        "name": "generate_confirmation",
        "display_name": "Generate Confirmation",
        "input_schema": {
          "$ref": "#/schemas/generate_confirmation_input"
        },
        "output_schema": {
          "$ref": "#/schemas/ConfirmationOutput"
        },
        "system_prompt": "You are a friendly bank assistant who writes short, professional confirmation messages.",
        "user_prompt": [
          "Write a short confirmation message for a new bank account request.",
          "Customer: {first_name} {last_name}",
          "Account type: {account_type}",
          "Phone number: {phone_number}",
          "The message must include: a personal greeting, a statement that the request was successfully submitted, a reference number, a note that an agent will call the customer at the phone number provided, and a sign-off from the bank."
        ],
        "llm": "watsonx/ibm/granite-4-h-small",
        "include_agent_context": false
      },
      "input_map": {
        "spec": {
          "maps": [
            {
              "target_variable": "self.input.first_name",
              "value_expression": "flow[\"account_creation_request\"][\"account_details\"].output.first_name",
              "has_no_value": false,
              "default_value": null,
              "metadata": {
                "assignmentType": "pyExpression"
              }
            },
            {
              "target_variable": "self.input.last_name",
              "value_expression": "flow[\"account_creation_request\"][\"account_details\"].output.last_name",
              "has_no_value": false,
              "default_value": null,
              "metadata": {
                "assignmentType": "pyExpression"
              }
            },
            {
              "target_variable": "self.input.account_type",
              "value_expression": "flow[\"account_creation_request\"][\"account_details\"].output.account_type",
              "has_no_value": false,
              "default_value": null,
              "metadata": {
                "assignmentType": "pyExpression"
              }
            },
            {
              "target_variable": "self.input.phone_number",
              "value_expression": "flow[\"account_creation_request\"][\"account_details\"].output.phone_number",
              "has_no_value": false,
              "default_value": null,
              "metadata": {
                "assignmentType": "pyExpression"
              }
            }
          ]
        }
      }
    },
