    "kind": "flow",
    "name": "create_new_bank_account_agentic_workflow",
    "display_name": "Create New Bank Account Agentic Workflow",
    "description": "Creates a request to open a new bank account. The user is asked to upload a picture of their passport.",
    "input_schema": {
      "$ref": "#/schemas/create_new_bank_account_agentic_workflow_input"
    },
