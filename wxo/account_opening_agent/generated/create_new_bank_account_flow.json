    "nationality_check": {
      "spec": {
        "kind": "branch",
        "name": "nationality_check",
        "display_name": "Nationality?",
        "evaluator": {
          "conditions": [
            {
              "expression": "str(flow[\"extract_passport_details\"].output.nationality).strip().lower() in ['spain', 'spanish', 'espa\u00f1a', 'espana', 'espa\u00f1ola', 'espanola', 'esp']",
              "node_id": "account_creation_request",
              "default": false
            },
            {
              "node_id": "not_supported",
              "default": true
            }
          ]
        },
        "cases": {},
        "match_policy": "FIRST_MATCH"
      }
