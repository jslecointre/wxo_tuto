        "display_name": "Extract Passport Details",
        "description": "Extracts the holder's details from a passport image.",
        "input_schema": {
          "$ref": "#/schemas/extract_passport_details_input"
        },
        "output_schema": {
          "$ref": "#/schemas/DocExtFieldValue"
        },
        "task": "custom_field_extraction",
        "enable_hw": false,
        "version": "TIP",
        "config": {
          "domain": "other",
          "type": "agreement",
          "llm": "watsonx/openai/gpt-oss-120b",
          "fields": [
            {
              "name": "Passport number",
              "type": "string",
              "description": "The passport number, usually printed at the top right of the data page.",
              "field_name": "passport_number",
              "multiple_mentions": false,
              "example_value": "",
              "examples": [],
              "available_options": null
            },
            {
              "name": "Nationality",
              "type": "string",
              "description": "Find the value in the field labeled Nationality and return the corresponding country name in English, for example Portuguese gives Portugal, Polish gives Poland, Spanish or Espa\u00f1ola gives Spain.",
              "field_name": "nationality",
              "multiple_mentions": false,
              "example_value": "",
              "examples": [],
              "available_options": null
            },
            {
              "name": "Given name",
              "type": "string",
              "description": "The given name(s) of the holder.",
              "field_name": "given_name",
              "multiple_mentions": false,
              "example_value": "",
              "examples": [],
              "available_options": null
            },
            {
              "name": "Surname",
              "type": "string",
              "description": "The surname(s) of the holder.",
              "field_name": "surname",
              "multiple_mentions": false,
              "example_value": "",
              "examples": [],
              "available_options": null
            },
            {
              "name": "Date of birth",
              "type": "string",
              "description": "The holder's date of birth. The label may be multilingual (e.g. 'Date of birth', 'Fecha de nacimiento', 'Date de naissance'). Never use the date of issue or the date of expiry. Return it as DD MMM YYYY, for example 08 AUG 1988.",
              "field_name": "date_of_birth",
              "multiple_mentions": false,
              "example_value": "",
              "examples": [],
              "available_options": null
            }
          ],
          "field_extraction_method": "classic",
          "page_range": null
        },
        "min_confidence": 0.0,
        "review_fields": [],
        "enable_review": false
      },
      "input_map": {
        "spec": {
          "maps": [
            {
              "target_variable": "self.input.document_ref",
              "value_expression": "flow.input.document_ref",
              "has_no_value": false,
              "default_value": null,
              "metadata": {
                "assignmentType": "pyExpression"
              }
            }
          ]
        }
      }
